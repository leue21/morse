telegram:
  bot_token: "YOUR_BOT_TOKEN"
  chat_id: 0

plugins:
  # Warns before a filesystem fills up. Both thresholds are checked and either
  # firing is enough: a percentage alone is useless on a large disk, an absolute
  # floor alone is useless on a small one.
  diskspace:
    interval: "15m"
    paths: ["/"]
    min_free_percent: 8.0
    min_free_gb: 120.0
    cooldown: "6h"
