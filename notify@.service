[Unit]
Description=Report that %i failed
# Deliberately no Requires= on morse.service: this must still deliver when the
# alerting daemon itself is the unit that died.

[Service]
Type=oneshot
# --user-unit=, not --user -u: the latter reads the calling user's own journal
# and returns nothing for a unit run by the user manager, which silently left
# every alert without its diagnostic.
# The excerpt arrives on stdin, which `morse send` uses as the body, so the
# message says what broke rather than only that something did.
ExecStart=/bin/sh -c 'journalctl --user-unit=%i -n 15 --no-pager --output=cat | %h/.local/bin/morse send "Unit failed: %i"'
# Never let a failing notifier become a second thing to chase.
TimeoutStartSec=30
