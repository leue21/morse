[Unit]
Description=morse - plugin-based Telegram notification service
After=network-online.target
Wants=network-online.target

# A unit only reaches "failed" — and so only triggers OnFailure — once it
# exhausts its start limit. The default window is 10s, so a service dying
# slowly restarts for ever and tells nobody. Five failures in five minutes
# means it is broken, not unlucky.
StartLimitIntervalSec=300
StartLimitBurst=5
OnFailure=notify@%n.service

[Service]
Type=simple
ExecStart=%h/.local/bin/morse
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
